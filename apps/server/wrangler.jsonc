{
  // One Worker serves the whole game (docs/DEPLOY.md): the web client as static assets,
  // and online rooms (one Durable Object per room) under /api/*.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "meow-night-market",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Built by `npm run build` (Vite). Static files are free and never run the Worker.
    // `npm run dev:server` creates it empty if missing: in development Vite serves the pages.
    "directory": "../web/dist",
    // Any other path (e.g. a shared link /room/ABCD) gets index.html: the client routes it.
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; everything else is served straight from the assets.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }],
  },
  // New-style Durable Object declaration (replaces the legacy `migrations` array).
  // SQLite storage is the only kind the Workers Free plan allows.
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" },
  },
  "observability": { "enabled": true },
}
